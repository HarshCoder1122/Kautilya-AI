# ============================================================================
#  KautilyaClaw — environment
#  Copy to `.env` and fill in. NEVER commit the real .env.
# ============================================================================

# ---- Kautilya model backend (the bot's brain) ------------------------------
# Your Kautilya backend's OpenAI-compatible base URL (must end in /v1).
# This is the same host the dashboard's Developer API uses.
KAUTILYA_BASE_URL=https://your-kautilya-backend.example.com/v1

# The MASTER api key (config.py KAUTILYA_API_KEY). It authenticates as uid
# "admin" and is UNMETERED — no daily Developer-API cap. Required so the
# agent loop isn't throttled mid-task.
KAUTILYA_API_KEY=kautilya-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- Gateway security ------------------------------------------------------
# Auth token for the OpenClaw gateway/dashboard. Generate with:
#   openssl rand -hex 32
OPENCLAW_GATEWAY_TOKEN=replace-with-openssl-rand-hex-32

# ---- Telegram channel ------------------------------------------------------
# Create a bot with @BotFather → it gives you a token like 123456:ABC-DEF...
TELEGRAM_BOT_TOKEN=123456:ABCDEFyourbottoken
# Your numeric Telegram user id (from @userinfobot). Only this id can DM the bot.
TELEGRAM_ALLOW_FROM=123456789

# ---- WhatsApp channel ------------------------------------------------------
# Your WhatsApp number (country code, NO +). e.g. 919812345678
WHATSAPP_ALLOW_FROM=919812345678

# ---- Gateway bind (Docker/host) --------------------------------------------
# Port the gateway/dashboard listens on. Default 18789.
OPENCLAW_PORT=18789
