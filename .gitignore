# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
bin/
build/
develop-eggs/
dist/
eggs/
# lib/
!frontend/src/lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# PyInstaller
#  Often these are written in relation to a build, so they can be ignored
#  unless they are checked-in to source.
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
.hypothesis/

# Flask stuff:
instance/
.webassets-cache

# Scrapy stuff:
.scrapy

# Sphinx documentation
docs/_build/

# PyBuilder
target/

# Jupyter Notebook
.ipynb_checkpoints

# pyenv
.python-version

# celery beat schedule file
celerybeat-schedule

# SageMath parsed files
*.sage.py

# dotenv
.env
.venv
env/
venv/
ENV/

# Spyder project settings
.spyderproject
.spyproject

# Rope project settings
.ropeproject

# mkdocs documentation
/site

# mypy
.mypy_cache/

# Node modules
node_modules/
frontend/node_modules/

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Logs
*.log
jarvis.log

# Dev scratch scripts & local Android project — kept on disk, never versioned.
# (Also blocks accidental `git add -A` from re-adding the 180MB JDK zip etc.)
/scratch/
/android/

# ── Secrets & local config ─────────────────────────
.env.*
!.env.example
*.pem
*.key
*serviceAccount*.json
*service-account*.json
*firebase-adminsdk*.json
.claude/settings.local.json

# ── Build output (regenerated by `npm run build`) ──
frontend/build/
backend/static/

# ── Runtime data ───────────────────────────────────
chat_data/
backend/chat_data/


# ── Claude Code local settings (contain machine paths / saved commands) ──
.claude/
