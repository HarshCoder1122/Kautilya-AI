# ═══════════════════════════════════════════════════════════════════════════
#  Kautilya AI — backend environment
#  Copy to `backend/.env` and fill in. NEVER commit the real .env.
#
#  Only the "Required" block is needed to boot and chat. Every other block
#  switches on an optional feature; leave it empty and that feature is
#  disabled (or falls back) with a note in the startup logs.
# ═══════════════════════════════════════════════════════════════════════════

# ─── Required ──────────────────────────────────────────────────────────────
# Random string used to sign Flask sessions:
#   python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# Chat models (Daily / Pro / Coder / Fast) run on Vertex AI Gemini.
# Service-account JSON on ONE line, with the "Vertex AI User" role.
# Leave empty locally to use `gcloud auth application-default login`.
GOOGLE_VERTEX_CREDENTIALS_JSON=
# Defaults to the service account's project_id
VERTEX_PROJECT_ID=
VERTEX_LOCATION=global

# Firebase Admin service account (Auth + Firestore). Paste the whole JSON on
# one line, or a path to the .json file.
# Firebase console → Project settings → Service accounts → Generate new key
FIREBASE_SERVICE_ACCOUNT_JSON=

# ─── Other model providers (optional) ──────────────────────────────────────
# Groq — Whisper speech-to-text + voice-agent fallback LLM
GROQ_API_KEY=
GROQ_API_KEY_BACKUP=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
GROQ_API_KEY_5=
# NVIDIA NIM — embeddings for the knowledge base (https://build.nvidia.com)
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
EMBED_MODEL=baai/bge-m3
NVIDIA_API_KEY=
NVIDIA_API_KEY_BACKUP=
NVIDIA_API_KEY_3=
NVIDIA_API_KEY_4=
NVIDIA_API_KEY_5=
# Gemini API (AI Studio) — vision, vector store, Gemini Live voice
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
# OpenRouter — last-resort fallback router
OPENROUTER_API_KEY=
# Model overrides for call analytics and Deep Research
NIM_ANALYTICS_MODEL=
NIM_ANALYTICS_FALLBACK_MODEL=
RESEARCH_PLANNER_MODEL=
RESEARCH_SYNTH_MODEL=
RESEARCH_SYNTH_FALLBACK_MODEL=
RESEARCH_SYNTH_RETRY_BACKOFF=
RESEARCH_SECOND_PASS=1
# LLM circuit breaker + response cache
LLM_CB_FAILURE_THRESHOLD=3
LLM_CB_COOLDOWN_SECONDS=
LLM_MEMCACHE_MAX=500
# Answer-quality features (1 = on)
TRUTH_LENS=1
ANSWER_SIZE_CLASSIFIER=0

# ─── Search & maps (optional) ──────────────────────────────────────────────
SERPAPI_API_KEY=
# Queried in parallel with SerpAPI and merged
TAVILY_API_KEY=
OMDB_API_KEY=
# Mappls (MapmyIndia). Without these, maps fall back to OpenStreetMap.
MAPPLS_API_KEY=
MAPPLS_CLIENT_ID=
MAPPLS_CLIENT_SECRET=
MAPPLS_MAP_SDK_KEY=
MAPPLS_REST_KEY=

# ─── Kautilya Computer — live headless browser (optional) ──────────────────
# Requires: pip install playwright && playwright install chromium
BROWSER_MAX_SESSIONS=2
BROWSER_SESSION_TTL_S=1800

# ─── Voice: TTS / STT (optional) ───────────────────────────────────────────
SARVAM_API_KEY=
CARTESIA_API_KEY=
ELEVENLABS_API_KEY=
# Self-hosted Kokoro / Indic TTS + STT engine ("RevealIQ ASR models/" folder).
# Point these at your own deployment.
REVEALIQ_TTS_URL=
STT_SPACE_BASE=
REVEALIQ_HF_TOKEN=
HF_TOKEN=

# ─── LiveKit realtime voice + SIP telephony (optional) ─────────────────────
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Your project's SIP domain, e.g. abc123.sip.livekit.cloud (differs from LIVEKIT_URL)
LIVEKIT_SIP_URI=
LIVEKIT_OUTBOUND_TRUNK_ID=
LIVEKIT_AGENT_NAME=
LIVEKIT_NUM_IDLE=2
LIVEKIT_SIP_DIRECT_DISPATCH=false
FREE_OUTBOUND_CALL_LIMIT=5

# Vobiz master account used for test calls from Agent Studio
VOBIZ_MASTER_USER=
VOBIZ_MASTER_PASS=
VOBIZ_MASTER_NUMBER=

# Outbound campaign dialer tuning
CAMPAIGN_CONCURRENCY=3
CAMPAIGN_GLOBAL_MAX=
CAMPAIGN_DIAL_PACING=
CAMPAIGN_POLL_INTERVAL=

# ─── Billing — Razorpay (optional) ─────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PRO_PLAN_ID=
PRO_PRICE_INR=599

# ─── Email — Resend (optional) ─────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM="Kautilya AI <hello@yourdomain.com>"
RESEND_MIN_INTERVAL=0.6
# Link used inside emails
APP_URL=http://localhost:3000
# Protects the /api/user/email-test endpoint
EMAIL_TEST_TOKEN=

# ─── Integrations — OAuth apps (optional) ──────────────────────────────────
# Pattern: <PROVIDER>_CLIENT_ID / <PROVIDER>_CLIENT_SECRET, e.g. HUBSPOT_,
# SALESFORCE_, SLACK_, GITHUB_, NOTION_, AIRTABLE_. Google, Microsoft and Zoho
# share one app per family: GOOGLE_ covers Gmail, Calendar, Drive, Sheets,
# Tasks, Docs, Contacts and YouTube.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Public domain that receives OAuth callbacks
CENTRAL_DOMAIN=

# ─── MCP (Model Context Protocol) servers ──────────────────────────────────
# Servers are declared in mcp_config.json
MCP_DISABLED=false
MCP_ENABLED_SERVERS=
MCP_SKIP_SERVERS=
MCP_SERVER_START_TIMEOUT=
MCP_INIT_JITTER_MAX=

# ─── KautilyaClaw — personal Telegram / WhatsApp agents (optional) ─────────
CLAW_PUBLIC_BASE=

# ─── Firebase web config served by /api/config/firebase (optional) ─────────
# Project ID is otherwise read from FIREBASE_SERVICE_ACCOUNT_JSON
FIREBASE_PROJECT_ID=
FIREBASE_AUTH_HOST=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# ─── Keep-warm pings for sleeping Spaces (optional) ────────────────────────
DISABLE_WARMUP=
WARMUP_INTERVAL_SEC=300
VOICE_SPACE_URL=
WARMUP_EXTRA_URLS=
WARMUP_LOCK_PATH=

# ─── Server & admin ────────────────────────────────────────────────────────
# Extra CORS origins, comma-separated (localhost is always allowed)
ALLOWED_ORIGINS=
# Public URL of this backend, used to build webhook URLs
PUBLIC_BASE_URL=
# Master API key: authenticates as "admin" on /api/v1/* (unmetered)
KAUTILYA_API_KEY=
ADMIN_SECRET_KEY=
PORT=7860
GUNICORN_WORKERS=12
GUNICORN_THREADS=32

# Code interpreter figure capture
KT_FIG_DIR=
KT_MAX_FIGS=6
