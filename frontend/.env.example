# ═══════════════════════════════════════════════════════════════════════════
#  Kautilya AI — frontend environment
#  Copy to `frontend/.env` (or `.env.local`) and fill in.
#
#  ⚠️  Every REACT_APP_* value is compiled INTO the public JavaScript bundle.
#      Put only values that are safe for any visitor to read here.
# ═══════════════════════════════════════════════════════════════════════════

# ─── Build-time (React) ────────────────────────────────────────────────────
# Flask backend URL. Leave empty to use the same origin (when Flask serves the build).
REACT_APP_API_URL=http://localhost:5000

# Firebase web app config — Firebase console → Project settings → Your apps → Web
# (public by design; access is enforced by authorised domains + Security Rules)
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=your-project
REACT_APP_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=
REACT_APP_FIREBASE_MEASUREMENT_ID=
# Alternative: the whole config object as one JSON string
# REACT_APP_FIREBASE_CONFIG={"apiKey":"...","authDomain":"...","projectId":"..."}

# ⛔ Do NOT set REACT_APP_HF_API_TOKEN in a public build — it would ship your
#    Hugging Face token to every visitor. For a private HF Space backend, run
#    `npm start` (server.js) with HF_TOKEN below instead; it adds the token
#    server-side when proxying /api/*.
# REACT_APP_HF_API_TOKEN=

# ─── Runtime (server.js production proxy — never sent to the browser) ──────
BACKEND_URL=http://localhost:5000
HF_TOKEN=
PORT=8000
